<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/credit-card-risk-ontology#"
     xml:base="http://www.example.org/credit-card-risk-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">

    <owl:Ontology rdf:about="http://www.example.org/credit-card-risk-ontology"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#Country"/>
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#Continent"/>
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#Merchant"/>
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#Transaction"/>
    <owl:Class rdf:about="http://www.example.org/credit-card-risk-ontology#StoreType">
        <owl:EquivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/credit-card-risk-ontology#Physical"/>
                    <rdf:Description rdf:about="http://www.example.org/credit-card-risk-ontology#Online"/>
                </owl:oneOf>
            </owl:Class>
        </owl:EquivalentClass>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#belongsToContinent">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#Continent"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasCardholder">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasMerchant">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#locatedIn">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#merchantLocatedIn">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasStoreType">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-card-risk-ontology#StoreType"/>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasName">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#merchantName">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasAmount">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasTimestamp">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasRiskScore">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-card-risk-ontology#hasDecision">
        <rdfs:domain rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Individuals: Continents -->
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Europe">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Continent"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Africa">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Continent"/>
    </owl:NamedIndividual>

    <!-- Country individuals (only few shown for brevity) -->
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Italy">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Europe"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Germany">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Europe"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Switzerland">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Europe"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Tanzania">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Africa"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#SouthAfrica">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Africa"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#Morocco">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Country"/>
        <belongsToContinent rdf:resource="http://www.example.org/credit-card-risk-ontology#Africa"/>
    </owl:NamedIndividual>

    <!-- Cardholders -->
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#C1">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mensoni</hasName>
        <locatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#Italy"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#C2">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">meyer</hasName>
        <locatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#Germany"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#C3">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">suter</hasName>
        <locatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#Switzerland"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#C4">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Cardholder"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abba</hasName>
        <locatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#Tanzania"/>
    </owl:NamedIndividual>

    <!-- Merchants -->
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#M1">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <merchantName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worldofafrica</merchantName>
        <merchantLocatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#SouthAfrica"/>
        <hasStoreType rdf:resource="http://www.example.org/credit-card-risk-ontology#Physical"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#M2">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <merchantName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">windsofthedeserts</merchantName>
        <merchantLocatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#Morocco"/>
        <hasStoreType rdf:resource="http://www.example.org/credit-card-risk-ontology#Physical"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#M3">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Merchant"/>
        <merchantName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mamaafrica</merchantName>
        <merchantLocatedIn rdf:resource="http://www.example.org/credit-card-risk-ontology#SouthAfrica"/>
        <hasStoreType rdf:resource="http://www.example.org/credit-card-risk-ontology#Physical"/>
    </owl:NamedIndividual>

    <!-- Transactions -->
    <owl:NamedIndividual rdf:about="http://www.example.org/credit-card-risk-ontology#TX1">
        <rdf:type rdf:resource="http://www.example.org/credit-card-risk-ontology#Transaction"/>
        <hasCardholder rdf:resource="http://www.example.org/credit-card-risk-ontology#C1"/>
        <hasMerchant rdf:resource="http://www.example.org/credit-card-risk-ontology#M1"/>
        <hasAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11234</hasAmount>
        <hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1715097900</hasTimestamp>
    </owl:NamedIndividual>

    <!-- Similar for TX2, TX3, TX4, TX5... -->

    <!-- SWRL Rules for Risk Scores -->
    <!-- Note: SWRL rules require a reasoner that supports them (e.g., Pellet, HermiT with SWRL) -->

    <!-- Merchant risk -->
    <swrl:Imp rdf:about="http://www.example.org/credit-card-risk-ontology#MerchantRiskItaly">
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.example.org/credit-card-risk-ontology#merchantLocatedIn"/>
                <swrl:argument1 rdf:resource="http://www.example.org/credit-card-risk-ontology#m"/>
                <swrl:argument2 rdf:resource="http://www.example.org/credit-card-risk-ontology#Italy"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:DataValuedPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.example.org/credit-card-risk-ontology#hasMerchantRisk"/>
                <swrl:argument1 rdf:resource="http://www.example.org/credit-card-risk-ontology#m"/>
                <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</swrl:argument2>
            </swrl:DataValuedPropertyAtom>
        </swrl:head>
    </swrl:Imp>

    <!-- Similar for merchant risk Europe (20), Africa (60), default (0) -->
    <!-- Cardholder risk: similar rules -->
    <!-- Amount risk: using swrlb:lessThan, swrlb:greaterThanOrEqual, etc. -->
    <!-- Special risk: Switzerland + South Africa => 30 -->
    <!-- Time comparison risk: needs complex SWRL with temporal difference -->
    <!-- Summation: add all partial scores into hasRiskScore -->
    <!-- Decision rule: if score <=100 -> "accepted", etc. -->

</rdf:RDF>